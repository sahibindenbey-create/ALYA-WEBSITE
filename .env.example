# ===== SQL Server =====
# 'sa' hesabı KULLANMAYIN: yalnızca bu veritabanında SELECT/INSERT/UPDATE yetkisi olan ayrı bir kullanıcı açın.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=ALYA_HOMES
SQL_USER=alya_app
SQL_PASSWORD=CHANGE_ME
# Üretimde bağlantıyı şifreleyin; sertifika güvenilir değilse SQL_TRUST_SERVER_CERTIFICATE=true yerine geçerli sertifika kurun.
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false

# ===== Ödeme =====
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=change-this-to-a-long-random-secret-min-32-chars
FREE_SHIPPING_THRESHOLD=1000
STANDARD_SHIPPING_FEE=99

# ===== Yönetim paneli =====
# openssl rand -base64 48   ile üretin. ADMIN_PASSWORD >= 12, ADMIN_SESSION_SECRET >= 32 karakter olmalı (aksi halde giriş kapalıdır).
ADMIN_USERNAME=CHANGE_ME_NOT_admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://shop.alyahomes.com
# Sunucunun kendi iç adresi (kargo ağ geçidi iç çağrıları için; Host başlığına güvenmemek için)
INTERNAL_BASE_URL=http://127.0.0.1:3002
# Kart ödemesi harici sayfaya form ile yönlendiriyorsa, CSP form-action'a eklenecek adres
CSP_FORM_ACTION_EXTRA=
