# SQL Server bağlantısı (SQL Authentication)
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=ALYA_HOMES
SQL_USER=sa
SQL_PASSWORD=CHANGE_ME
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# Payment provider callback verification
PAYMENT_WEBHOOK_SECRET=change-this-to-a-long-random-secret

# Admin panel authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Site mode
# shop: full e-commerce experience for shop.alyahomes.com
# catalog: product-presentation experience for alyahomes.com.tr
SITE_MODE=shop
NEXT_PUBLIC_SITE_MODE=shop
NEXT_PUBLIC_SHOP_URL=https://shop.alyahomes.com

# ===== Güvenlik (V26) =====
# ADMIN_PASSWORD >= 12, ADMIN_SESSION_SECRET >= 32 karakter olmalı; aksi halde yönetici girişi bilerek KAPALI kalır.
#   openssl rand -base64 48
# Yönetici adı 'admin' olmasın. SQL için 'sa' yerine yetkisi kısıtlı ayrı kullanıcı kullanın; SQL_ENCRYPT=true.
INTERNAL_BASE_URL=http://127.0.0.1:3002
CSP_FORM_ACTION_EXTRA=
# CSP'yi önce denemek için: CSP_REPORT_ONLY=true
CSP_REPORT_ONLY=false

# ===== Müşteri girişi (e-posta kodu) =====
# Kod e-postayla gönderilir. GoDaddy e-postası için tipik: SMTP_HOST=smtpout.secureserver.net, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ALYA HOMES <no-reply@alyahomes.com.tr>"
# İsteğe bağlı (en az 32 karakter). Boşsa ADMIN_SESSION_SECRET'tan türetilir.
CUSTOMER_SESSION_SECRET=
